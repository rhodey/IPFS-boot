# syntax=docker/dockerfile:1
FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f AS alpine

FROM alpine AS kubo
ARG TARGETARCH
RUN apk add --no-cache curl
RUN <<'EOF'
set -eu

# Keep the version and release checksums together when updating Kubo.
version=0.32.0
case "$TARGETARCH" in
  amd64) checksum=f0a5afe5b7618b15610d52a5b2318e3fd09e0b2d9ada203e06fbe4ce7141a8d280e2ac26b6a7362e6a40efced707000eb1f4d4f4d11a08a46f5b7b27caf7b832 ;;
  arm64) checksum=7a1fa43a0324a930caccea070f210436fee5c6b67b3415770d4798f9021ca6702940108fdca0c337636c4564d9d7c9d2cad65cb82e2d904b3df52472025f548e ;;
  *) echo "Unsupported Kubo architecture: $TARGETARCH" >&2; exit 1 ;;
esac

archive="kubo_v${version}_linux-$TARGETARCH.tar.gz"
cd /tmp
curl --fail --location --show-error --silent --retry 2 \
  --connect-timeout 15 --max-time 120 \
  "https://github.com/ipfs/kubo/releases/download/v${version}/${archive}" -o "$archive"
printf '%s  %s\n' "$checksum" "$archive" | sha512sum -c -
tar -xzf "$archive" kubo/ipfs
install -m 755 kubo/ipfs /usr/local/bin/ipfs
rm -rf "$archive" kubo
EOF

FROM alpine
# Alpine's musl-compatible AWS CLI; no bundled glibc installer is needed.
RUN apk add --no-cache aws-cli=2.27.25-r0 ca-certificates gcompat
ENV IPFS_PATH=/tmp/ipfs \
    AWS_PAGER=""
COPY --from=kubo /usr/local/bin/ipfs /usr/local/bin/ipfs
RUN ipfs version && aws --version
COPY --chmod=755 <<'EOF' /usr/local/bin/pin-dist
#!/bin/sh
set -eu

if [ -z "${pin_api:-}${pin_filebase_bucket:-}" ]; then
  echo "Configure at least one pin service in .env (see PIN.md)." >&2
  exit 1
fi
if [ ! -d /root/dist ] || [ -z "$(ls -A /root/dist)" ]; then
  echo "Mount a nonempty build directory at /root/dist." >&2
  exit 1
fi
if [ -n "${pin_api:-}" ]; then
  : "${pin_token:?Set pin_token for the remote pinning service}"
fi
if [ -n "${pin_filebase_bucket:-}" ]; then
  : "${pin_filebase_access:?Set pin_filebase_access}" "${pin_filebase_secret:?Set pin_filebase_secret}"
fi

ipfs init >/dev/null
cid=$(ipfs --offline add -Qr /root/dist)
cb32=$(ipfs cid base32 "$cid")
echo "CIDv0 = $cid"
echo "CIDv1 = $cb32"

# Filebase uploads a CAR; only native remote pinning needs a daemon.
if [ -n "${pin_filebase_bucket:-}" ]; then
  ipfs dag export "$cb32" > /tmp/dist.car
fi

if [ -n "${pin_api:-}" ]; then
  ipfs daemon > /tmp/ipfs-daemon.log 2>&1 &
  daemon_pid=$!
  trap 'kill "$daemon_pid" 2>/dev/null || true; wait "$daemon_pid" 2>/dev/null || true' EXIT
  trap 'exit 1' INT TERM
  attempts=0
  until ipfs --api=/ip4/127.0.0.1/tcp/5001 id >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 30 ] || ! kill -0 "$daemon_pid" 2>/dev/null; then
      cat /tmp/ipfs-daemon.log >&2
      exit 1
    fi
    sleep 1
  done
  ipfs pin remote service add my_pin "$pin_api" "$pin_token"
  echo "Waiting for remote pinning; reachability through NAT can affect completion."
  ipfs pin remote add --service=my_pin "$cb32"
fi

if [ -n "${pin_filebase_bucket:-}" ]; then
  export AWS_DEFAULT_REGION=us-east-1
  export AWS_ACCESS_KEY_ID="$pin_filebase_access"
  export AWS_SECRET_ACCESS_KEY="$pin_filebase_secret"
  aws --endpoint-url https://s3.filebase.com s3 cp /tmp/dist.car \
    "s3://$pin_filebase_bucket/$cb32" --metadata 'import=car'
fi

echo "done: https://$cb32.ipfs.dweb.link/"
EOF
CMD ["pin-dist"]
